QMainWindow {
    background-color: #f5f7fa;
}

QFrame {
    background-color: #ffffff;
    border: 1px solid #d9dee7;
    border-radius: 8px;
}

QLabel {
    color: #1f2937;
}

QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: none;
    border-radius: 6px;
    padding: 10px 14px;
    text-align: left;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #eef2f7;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QStatusBar {
    background-color: #ffffff;
    color: #64748b;
    border-top: 1px solid #d9dee7;
}
/* Dashboard */

#pageTitle {
    font-size: 28px;
    font-weight: bold;
    color: #1f2937;
}

#pageSubtitle {
    font-size: 16px;
    color: #64748b;
}

#statCard {
    background-color: #ffffff;
    border: 1px solid #d9dee7;
    border-radius: 10px;
}

#statCardTitle {
    font-size: 14px;
    color: #64748b;
}

#statCardValue {
    font-size: 28px;
    font-weight: bold;
    color: #1f2937;
}

#sectionTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1f2937;
    margin-top: 10px;
}

#activityPlaceholder {
    background-color: #ffffff;
    border: 1px solid #d9dee7;
    border-radius: 8px;
    padding: 15px;
    color: #64748b;
}